*

# Exact build/runtime inputs only.
!Dockerfile
!requirements.lock
!common.py
!inventory.py
!provision.py
!runner_control.py
!test_security.py
!test_admission_faults.py

# Reopen the parent, exclude all children, then admit exact SQL inputs.
!sql/
sql/**
!sql/00_roles.sql
!sql/10_boundary.sql

!wheelhouse/
wheelhouse/**
!wheelhouse/psycopg-3.2.10-py3-none-any.whl
