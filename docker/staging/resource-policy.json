      "cpus": 0.25,
      "pids_limit": 128
    },
    "backend": {
      "mem_limit": "640m",
      "memswap_limit": "640m",
      "cpus": 0.4,
      "pids_limit": 128
    },
    "mail": {
      "mem_limit": "128m",
      "memswap_limit": "128m",
      "cpus": 0.1,
      "pids_limit": 64
    },
    "frontend": {
      "mem_limit": "128m",
      "memswap_limit": "128m",
      "cpus": 0.1,
      "pids_limit": 64
    }
