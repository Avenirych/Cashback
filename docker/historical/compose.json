{
  "name": "cashback-historical-03573b7-local",
  "services": {
    "historical-postgres": {
      "image": "postgres:17-bookworm@sha256:66aafa11cf15800a3c94763f7e11d1e7b2e37e5e84bc4ce027cb6e1e4bfaf4df",
      "pull_policy": "never",
      "environment": {
        "POSTGRES_DB": "cashback_historical_03573b7",
        "POSTGRES_USER": "cashback_hist_owner",
        "POSTGRES_PASSWORD": "${HISTORICAL_OWNER_PASSWORD:?Set a new isolated owner password}"
      },
      "volumes": [
        "database:/var/lib/postgresql/data"
      ],
      "networks": [
        "database"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U cashback_hist_owner -d cashback_historical_03573b7"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "historical-mailpit": {
      "image": "axllent/mailpit:v1.31.5@sha256:94f6b70c1436defae6799d9ac7ff0eeff9540465b842026d5cdb018f1c0234ea",
      "pull_policy": "never",
      "environment": {
        "MP_MAX_MESSAGES": "100"
      },
      "ports": [
        "127.0.0.1:8036:8025"
      ],
      "networks": [
        "application"
      ]
    },
    "backend": {
      "image": "cashback-historical-security:2b1b3a03-9e8a-4918-aa88-b2c1ad42a830",
      "pull_policy": "never",
      "build": {
        "context": "../..",
        "dockerfile": "docker/historical/backend.Dockerfile"
      },
      "environment": {
        "NODE_ENV": "development",
        "HISTORICAL_LOCAL": "true",
        "HISTORICAL_CONTAINER": "true",
        "HOST": "0.0.0.0",
        "PORT": "3006",
        "DB_HOST": "historical-postgres",
        "DB_PORT": "5432",
        "DB_NAME": "cashback_historical_03573b7",
        "DB_USER": "cashback_hist_runtime",
        "DB_PASSWORD": "${HISTORICAL_RUNTIME_PASSWORD:?Set a new isolated runtime password}",
        "JWT_SECRET": "${HISTORICAL_JWT_SECRET:?Set a new isolated JWT secret}",
        "FRONTEND_URL": "http://localhost:3004",
        "SMTP_HOST": "historical-mailpit",
        "SMTP_PORT": "1025",
        "SMTP_SECURE": "false",
        "USE_ETHEREAL": "false",
        "SMTP_FROM": "Cashback Historical <noreply@example.test>"
      },
      "ports": [
        "127.0.0.1:3006:3006"
      ],
      "depends_on": {
        "historical-postgres": {
          "condition": "service_healthy"
        },
        "historical-mailpit": {
          "condition": "service_started"
        }
      },
      "networks": [
        "database",
        "application"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        "avatars:/app/public/avatars"
      ]
    },
    "frontend": {
      "image": "cashback-historical-03573b7-local-frontend:local",
      "pull_policy": "never",
      "build": {
        "context": "../..",
        "dockerfile": "docker/historical/frontend.Dockerfile"
      },
      "environment": {
        "HOST": "0.0.0.0",
        "PORT": "3000",
        "BROWSER": "none",
        "REACT_APP_API_BASE": "http://127.0.0.1:3006",
        "WDS_SOCKET_PORT": "3004"
      },
      "ports": [
        "127.0.0.1:3004:3000"
      ],
      "networks": [
        "application"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  },
  "volumes": {
    "database": {
      "name": "cashback-historical-03573b7-local-pgdata"
    },
    "avatars": {
      "name": "cashback-historical-03573b7-local-avatars"
    }
  },
  "networks": {
    "database": {
      "name": "cashback-historical-03573b7-local-database",
      "internal": true
    },
    "application": {
      "name": "cashback-historical-03573b7-local-application"
    }
  }
}
