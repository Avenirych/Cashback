# Nonsecret template only. Real password files MUST be outside the repository.
# Replace placeholder digests with reviewed available image digests before building.
FS_PG_IMAGE=postgres:17-bookworm@sha256:REPLACE_WITH_REVIEWED_DIGEST
FS_EXPECTED_CLUSTER=REPLACE_AFTER_INDEPENDENT_NEW_CLUSTER_INVENTORY
FS_BOOTSTRAP_FILE=C:/EXTERNAL_SECRET_DIRECTORY/bootstrap
FS_INSTALLER_FILE=C:/EXTERNAL_SECRET_DIRECTORY/installer
FS_RUNTIME_FILE=C:/EXTERNAL_SECRET_DIRECTORY/runtime
FS_AUTHORITY_FILE=C:/EXTERNAL_SECRET_DIRECTORY/authority
FS_OPERATOR_FILE=C:/EXTERNAL_SECRET_DIRECTORY/operator
