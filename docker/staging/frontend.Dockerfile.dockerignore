# Staging-only allowlist; takes precedence over root .dockerignore.
**
!cashback-frontend/
!cashback-frontend/package.json
!cashback-frontend/package-lock.json
!cashback-frontend/tsconfig.json
!cashback-frontend/public/
!cashback-frontend/public/**
!cashback-frontend/src/
!cashback-frontend/src/**
!cashback-frontend/scripts/
!cashback-frontend/scripts/**
!docker/
!docker/staging/
!docker/staging/frontend.Dockerfile
!docker/staging/check-bundle.cjs
!docker/staging/nginx.conf
!docker/staging/security-headers.conf
!docker/staging/frontend-entry.sh
!docker/staging/robots.txt

# Secret/data exclusions apply after allowlists, including extensionless file secrets.
**/node_modules
**/.git
**/.env*
**/.npmrc
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.dpapi
**/*.dump
**/*.db
**/*.sqlite*
**/secrets
**/.secrets
**/db_password
**/jwt_secret
**/smtp_password
**/pg_owner_password
**/web_key
**/mail_key
**/pg_key
**/mail_auth
**/build
**/dist
**/coverage
**/*.log
